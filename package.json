{
  "name": "twitch-mod-manager",
  "version": "1.0.4",
  "description": "Application de bureau pour afficher et gérer toutes les chaînes Twitch où vous êtes modérateur.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node tests/test-logic.js && node tests/test-oauth-state.js",
    "predist": "node -e \"require('fs').writeFileSync('src/build-info.json', JSON.stringify({ buildDate: new Date().toISOString() }))\"",
    "dist": "electron-builder --win --publish never"
  },
  "keywords": [
    "twitch",
    "moderation",
    "electron"
  ],
  "author": "cheche03fr",
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "fr.cheche03.twitchmodmanager",
    "productName": "Twitch Mod Manager",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "nsis"
      ],
      "signtoolOptions": {
        "publisherName": "cheche03fr"
      },
      "verifyUpdateCodeSignature": false
    },
    "copyright": "Copyright (c) 2026 cheche03fr. Tous droits réservés.",
    "publish": {
      "provider": "github",
      "owner": "cheche03fr",
      "repo": "twitch-mod-manager",
      "releaseType": "release"
    },
    "nsis": {
      "artifactName": "Twitch-Mod-Manager-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
